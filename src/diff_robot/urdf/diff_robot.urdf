<?xml version="1.0"?>
<robot name="diff_robot">

<material name="black">
    <color rgba="0 0 0 1.0"/>
</material>

<material name="grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
</material>

<material name="green">
    <color rgba="0.0 0.6 0 1.0"/>
</material>

<material name="white">
    <color rgba="1 1 1 1.0"/>
</material>

<!-- ==================== LINKS ==================== -->

<link name="base_footprint"/>

<link name="base_link">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="1.5"/>
        <inertia ixx="0.001665" ixy="0.0" ixz="0.0" iyy="0.00441225" iyz="0.0" izz="0.00541625"/>
    </inertial>
    <visual>
        <geometry>
            <box size="0.7 0.4 0.2"/>
        </geometry>
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
        <material name="green"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.7 0.4 0.2"/>
        </geometry>
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
    </collision>
</link>

<link name="left_wheel">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.3"/>
        <inertia ixx="0.00081252" ixy="0.0" ixz="0.0" iyy="0.00081252" iyz="0.0" izz="0.0015"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
        <material name="black"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
    </collision>
</link>

<link name="right_wheel">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.3"/>
        <inertia ixx="0.00081252" ixy="0.0" ixz="0.0" iyy="0.00081252" iyz="0.0" izz="0.0015"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
        <material name="black"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
    </collision>
</link>

<link name="caster_wheel">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.00016666" ixy="0.0" ixz="0.0" iyy="0.00016666" iyz="0.0" izz="0.00016666"/>
    </inertial>
    <visual>
        <geometry>
            <sphere radius="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="black"/>
    </visual>
    <collision>
        <geometry>
            <sphere radius="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
</link>

<link name="imu_link">
    <visual>
        <origin rpy="0 0 0" xyz="0 0 0.0"/>
        <geometry>
            <box size="0.01 0.01 0.01"/>
        </geometry>
    </visual>
    <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
</link>

<link name="lidar_link">
    <visual>
        <geometry>
            <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="white"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
    <inertial>
        <mass value="0.114"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
</link>

<!-- ==================== JOINTS ==================== -->

<joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
</joint>

<joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
</joint>

<joint name="base_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.225" rpy="0.0 0.0 0.0"/>
</joint>

<joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.175 0.225 0.0" rpy="0 0.0 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <dynamics damping="0.2" friction="1.0"/>
    <limit effort="100" velocity="10.0"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.175 -0.225 0.0" rpy="0 0.0 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <dynamics damping="0.2" friction="1.0"/>
    <limit effort="100" velocity="10.0"/>
</joint>

<joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <dynamics damping="0.01" friction="0.0"/>
    <origin xyz="0.25 0.0 -0.05" rpy="0.0 0.0 0.0"/>
</joint>

<!-- ==================== ROS2 CONTROL (Gazebo Ignition) ==================== -->

<ros2_control name="GazeboSystem" type="system">
    <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
        <command_interface name="velocity">
            <param name="min">-10</param>
            <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
        <command_interface name="velocity">
            <param name="min">-10</param>
            <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>
</ros2_control>

<!-- ==================== GAZEBO IGNITION PLUGINS ==================== -->

<!-- Plugin gz_ros2_control pour charger le controller_manager -->
<gazebo>
    <plugin filename="ign_ros2_control-system"
            name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(find diff_robot)/config/diff_drive_controller.yaml</parameters>
    </plugin>
</gazebo>

<!-- Odometry Publisher (remplace libgazebo_ros_diff_drive.so) -->
<gazebo>
    <plugin filename="libignition-gazebo-odometry-publisher-system.so"
            name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <publish_rate>50.0</publish_rate>
    </plugin>
</gazebo>

<!-- IMU Sensor (Ignition) -->
<gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
            <angular_velocity>
                <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
                <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
                <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
                <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
                <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
                <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
            </linear_acceleration>
        </imu>
    </sensor>
</gazebo>

<!-- LiDAR Sensor (Ignition gpu_lidar) -->
<gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
            <scan>
                <horizontal>
                    <samples>480</samples>
                    <resolution>1</resolution>
                    <min_angle>-2.0944</min_angle>
                    <max_angle>2.0944</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.1</min>
                <max>12.0</max>
                <resolution>0.01</resolution>
            </range>
            <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
    </sensor>
</gazebo>

<!-- Couleurs Gazebo -->
<gazebo reference="base_link">
    <material>Gazebo/Green</material>
</gazebo>
<gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
</gazebo>
<gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
</gazebo>
<gazebo reference="caster_wheel">
    <material>Gazebo/Black</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
</gazebo>

</robot>
