<?xml version="1.0"?>
<robot name="robot_remorque" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== MATERIAUX ==================== -->
  <material name="silver"><color rgba="0.792 0.819 0.933 1.0"/></material>
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="white"><color rgba="1 1 1 1.0"/></material>
  <material name="trailer_grey"><color rgba="0.55 0.55 0.55 1.0"/></material>

  <!-- ==================== GPS & IMU SENSORS (Gazebo Fortress) ==================== -->
  <xacro:include filename="$(find diff_robot)/urdf/sensors_gps_imu.xacro"/>

  <!-- ==================== ROS2 CONTROL (Gazebo Fortress - gz_ros2_control) ==================== -->
  <xacro:include filename="$(find diff_robot)/urdf/tractor_ros2_control.xacro"/>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Z = wheel radius (0.085) so base_link centre sits at wheel-axle height -->
    <origin xyz="0 0 0.085" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK (Châssis) ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.02498 0.04137 -0.02147" rpy="0 0 0" />
      <mass value="10.0" />
      <inertia ixx="0.0489" ixy="-2.25e-07" ixz="0.0047" iyy="0.1173" iyz="1.87e-05" izz="0.1370" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/base_link.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.025 0.041 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.60 0.40 0.15" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ROUES MOTRICES ARRIÈRE (Diff Drive) ==================== -->
  <!-- rear_left — roue motrice gauche -->
  <link name="rear_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="2.0" />
      <!-- Cylindre r=0.085m h=0.05m axe=Y: iyy=m*r²/2=0.00723, ixx=izz=m*(3r²+h²)/12=0.00403 -->
      <inertia ixx="0.00403" ixy="0" ixz="0" iyy="0.00723" iyz="0" izz="0.00403" />
    </inertial>
    <visual>
      <origin xyz="-0.171 -0.20 0.116" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/front_left.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry><cylinder radius="0.085" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_joint" type="continuous">
    <!-- Z=-0.085 so wheel bottom (0.085 radius) touches Z=0 ground -->
    <origin xyz="-0.203 0.201 -0.085" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rear_left" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.0"/>
    <limit effort="50" velocity="2.0"/>
  </joint>

  <!-- ROS2 CONTROL: rear_left -->
  <gazebo reference="rear_left">
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <!-- rear_right — roue motrice droite -->
  <link name="rear_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="2.0" />
      <!-- Cylindre r=0.085m h=0.05m axe=Y: iyy=m*r²/2=0.00723, ixx=izz=m*(3r²+h²)/12=0.00403 -->
      <inertia ixx="0.00403" ixy="0" ixz="0" iyy="0.00723" iyz="0" izz="0.00403" />
    </inertial>
    <visual>
      <origin xyz="0.203 0.201 0.116" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/rear_right.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry><cylinder radius="0.085" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_joint" type="continuous">
    <origin xyz="-0.203 -0.201 -0.085" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rear_right" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.0"/>
    <limit effort="50" velocity="2.0"/>
  </joint>

  <!-- ROS2 CONTROL: rear_right -->
  <gazebo reference="rear_right">
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <!-- ==================== ROUES AVANT PASSIVES (Castors fixes) ==================== -->
  <!-- front_left — caster gauche motorisé -->
  <link name="front_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="2.0" />
      <!-- Caster passif — même géométrie roue: iyy=0.00723, ixx=izz=0.00403 -->
      <inertia ixx="0.00403" ixy="0" ixz="0" iyy="0.00723" iyz="0" izz="0.00403" />
    </inertial>
    <visual>
      <origin xyz="-0.171 -0.242 0.116" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/front_left.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry><cylinder radius="0.085" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="front_left_joint" type="continuous">
    <origin xyz="0.171 0.242 -0.085" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_left" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.0"/>
    <limit effort="50" velocity="2.0"/>
  </joint>

  <!-- ROS2 CONTROL: front_left -->
  <gazebo reference="front_left">
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <!-- front_right — caster droit motorisé -->
  <link name="front_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="2.0" />
      <!-- Caster passif — même géométrie roue: iyy=0.00723, ixx=izz=0.00403 -->
      <inertia ixx="0.00403" ixy="0" ixz="0" iyy="0.00723" iyz="0" izz="0.00403" />
    </inertial>
    <visual>
      <origin xyz="-0.171 0.159 0.116" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/front_right.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry><cylinder radius="0.085" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="front_right_joint" type="continuous">
    <origin xyz="0.171 -0.159 -0.085" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_right" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.0"/>
    <limit effort="50" velocity="2.0"/>
  </joint>

  <!-- ROS2 CONTROL: front_right -->
  <gazebo reference="front_right">
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <!-- ==================== SUPPORT CAPTEURS ==================== -->
  <link name="support">
    <inertial>
      <origin xyz="-0.0289 0.0413 0.138" rpy="0 0 0" />
      <mass value="0.0086" />
      <inertia ixx="7.72e-06" ixy="0" ixz="0" iyy="4.13e-06" iyz="0" izz="3.64e-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/support.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Pas de collision pour le support capteurs pour éviter les frottements parasites -->
  </link>
  <joint name="support_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="support" />
  </joint>

  <!-- ==================== GPS ==================== -->
  <!-- Défini dans sensors_gps_imu.xacro (inclusion ligne 12) -->

  <!-- ==================== CAMERA ==================== -->
  <link name="camera_link">
    <inertial>
      <origin xyz="-0.012 0.041 0.166" rpy="0 0 0" />
      <mass value="0.107" />
      <inertia ixx="7.12e-05" ixy="0" ixz="0" iyy="7.70e-06" iyz="0" izz="7.02e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/camera.STL" />
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Pas de collision pour la caméra pour éviter les frottements parasites -->
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.08 0 0.14" rpy="0 0.44 0" />
    <parent link="support" />
    <child link="camera_link" />
  </joint>

  <!-- ==================== LIDAR (YDLidar) ==================== -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="-0.02 0.04 0.20" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- ==================== IMU ==================== -->
  <!-- Défini dans sensors_gps_imu.xacro (inclusion ligne 12) -->

  <!-- ==================== REMORQUE (hitch_joint + trailer_base_link + roues) ==================== -->

  <!-- HITCH JOINT — joint révolu ±45° anti-jackknifing -->
  <joint name="hitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="trailer_base_link"/>
    <!-- Z=-0.085: same as wheels so trailer_base_link centre is at axle height (ground level) -->
    <origin xyz="-0.3575 0.0414 -0.085" rpy="0 0 3.1416"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="100" velocity="2"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- TRAILER BASE LINK -->
  <link name="trailer_base_link">
    <visual>
      <origin xyz="0 0 0.02737" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/trailer_body.stl" scale="0.00017264 0.00017264 0.00017264"/>
      </geometry>
      <material name="trailer_grey"/>
    </visual>
    <!-- Collision désactivée pour permettre le mouvement correct du robot -->
    <collision>
      <origin xyz="0.4 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.80 0.50 0.15" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- TRAILER CART DROP POINT FRAME (Target drop position for panda arm) -->
  <link name="trailer_cart_drop_point"/>
  <joint name="trailer_cart_drop_joint" type="fixed">
    <parent link="trailer_base_link"/>
    <child link="trailer_cart_drop_point"/>
    <origin xyz="0.4 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- TRAILER WHEEL LEFT -->
  <link name="trailer_wheel_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/trailer_wheel_left.stl" scale="0.00017264 0.00017264 0.00017264"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.085" length="0.05"/>
      </geometry>
    </collision>
    <!-- Cylindre r=0.085 h=0.05 m=0.2kg: iyy=0.000723, ixx=izz=0.000403 -->
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000403" ixy="0" ixz="0" iyy="0.000723" iyz="0" izz="0.000403"/>
    </inertial>
  </link>
  <joint name="trailer_wheel_left_joint" type="continuous">
    <parent link="trailer_base_link"/>
    <child link="trailer_wheel_left"/>
    <!-- trailer_base_link is already at axle height, so wheel Z offset = 0 -->
    <origin xyz="0.5000 -0.19187 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
    <limit effort="50" velocity="2.0"/>
  </joint>

  <!-- ROS2 CONTROL: trailer_wheel_left -->
  <gazebo reference="trailer_wheel_left">
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <!-- TRAILER WHEEL RIGHT -->
  <link name="trailer_wheel_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://diff_robot/urdf/meshes/trailer_wheel_right.stl" scale="0.00017264 0.00017264 0.00017264"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.085" length="0.05"/>
      </geometry>
    </collision>
    <!-- Cylindre r=0.085 h=0.05 m=0.2kg: iyy=0.000723, ixx=izz=0.000403 -->
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000403" ixy="0" ixz="0" iyy="0.000723" iyz="0" izz="0.000403"/>
    </inertial>
  </link>
  <joint name="trailer_wheel_right_joint" type="continuous">
    <parent link="trailer_base_link"/>
    <child link="trailer_wheel_right"/>
    <origin xyz="0.5000 0.19183 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
    <limit effort="50" velocity="2.0"/>
  </joint>

  <!-- ROS2 CONTROL: trailer_wheel_right -->
  <gazebo reference="trailer_wheel_right">
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <!-- ==================== GAZEBO COLORS ==================== -->
  <gazebo reference="base_link"><material>Gazebo/Silver</material></gazebo>
  <!-- Roues motrices : mu élevé + kp/kd pour contact sol stable -->
  <gazebo reference="rear_left">
    <material>Gazebo/Black</material>
    <mu1>100.0</mu1><mu2>100.0</mu2>
    <kp>1000000.0</kp><kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="rear_right">
    <material>Gazebo/Black</material>
    <mu1>100.0</mu1><mu2>100.0</mu2>
    <kp>1000000.0</kp><kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <!-- Roues avant = casters passifs : mu très bas pour rotation libre sans résistance -->
  <gazebo reference="front_left">
    <material>Gazebo/Black</material><mu1>0.1</mu1><mu2>0.1</mu2><minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="front_right">
    <material>Gazebo/Black</material><mu1>0.1</mu1><mu2>0.1</mu2><minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="support"><material>Gazebo/Silver</material></gazebo>
  <gazebo reference="camera_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="lidar_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="imu_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="gps_link"><material>Gazebo/White</material></gazebo>
  <gazebo reference="trailer_base_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="trailer_wheel_left">
    <material>Gazebo/Black</material><mu1>0.1</mu1><mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="trailer_wheel_right">
    <material>Gazebo/Black</material><mu1>0.1</mu1><mu2>0.1</mu2>
  </gazebo>

  <!-- ==================== GAZEBO CLASSIC PLUGINS REMOVED ==================== -->
  <!-- Old libgazebo_ros_diff_drive.so removed - replaced by gz_ros2_control -->
  <!-- Old libgazebo_ros_joint_state_publisher.so removed - replaced by joint_state_broadcaster -->

  <!-- ==================== GAZEBO PLUGIN — LIDAR (Fortress syntax) ==================== -->
  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>240</samples>
            <resolution>1</resolution>
            <min_angle>-2.0944</min_angle>
            <max_angle>2.0944</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ==================== OLD IMU PLUGIN REMOVED ==================== -->
  <!-- IMU is now handled by sensors_gps_imu.xacro with Fortress syntax -->

  <!-- ==================== OLD GPS PLUGIN REMOVED ==================== -->
  <!-- GPS is now handled by sensors_gps_imu.xacro with Fortress syntax -->

  <!-- ==================== GAZEBO PLUGIN — CAMERA (Fortress syntax) ==================== -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <topic>image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>300</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ==================== OLD TRAILER ODOMETRY PLUGIN REMOVED ==================== -->
  <!-- Trailer odometry is now handled by odometry_publisher.py -->

</robot>
