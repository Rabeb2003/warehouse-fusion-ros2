<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mecanum_warehouse">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light name="overhead" type="directional">
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ROBOT TABLE / MOUNTING PEDESTAL & WORKSTATION TABLES     -->
    <!-- ======================================================== -->

    <!-- Robot Support Pedestal (Robot sits on top at Z = 0.4) -->
    <model name="robot_pedestal">
      <static>true</static>
      <pose>0.0 0.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.25 1</ambient>
            <diffuse>0.2 0.2 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pick Table in front of Panda arm -->
    <model name="pick_table">
      <static>true</static>
      <pose>0.5 0.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.5 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.4 1</ambient>
            <diffuse>0.35 0.35 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Red Cube to Pick Up -->
    <model name="target_block">
      <static>false</static>
      <pose>0.5 0.0 0.425 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00001</iyy><iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.04 0.04 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>50.0</mu><mu2>50.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.04 0.04 0.05</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Place Platform on the left -->
    <model name="place_table">
      <static>true</static>
      <pose>0.0 0.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.7 1</ambient>
            <diffuse>0.2 0.4 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- WAREHOUSE ENVIRONMENT WALLS AND STRUCTURES               -->
    <!-- ======================================================== -->

    <!-- South wall -->
    <model name="south_wall"><static>true</static><pose>0 -7 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>16 0.2 2.0</size></box></geometry>
        <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- North wall -->
    <model name="north_wall"><static>true</static><pose>0 7 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>16 0.2 2.0</size></box></geometry>
        <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="west_wall"><static>true</static><pose>-8 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 14 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 14 2.0</size></box></geometry>
        <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="east_wall"><static>true</static><pose>8 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 14 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 14 2.0</size></box></geometry>
        <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Shelves -->
    <model name="shelf_1"><static>true</static><pose>2.0 4.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.5 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.5 0.8</size></box></geometry>
        <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="shelf_2"><static>true</static><pose>2.0 -4.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.5 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.5 0.8</size></box></geometry>
        <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
