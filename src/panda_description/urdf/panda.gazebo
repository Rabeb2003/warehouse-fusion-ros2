<?xml version="1.0"?>
<!-- Macros that add Ignition Gazebo plugins for Franka Emika Panda -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--       -->
  <!-- Macro -->
  <!--       -->
  <xacro:macro name="ign_ros2_control" params="
   controller_parameters
   robot_param_node:=panda_robot_state_publisher
  ">
    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>${controller_parameters}</parameters>
        <robot_param>robot_description</robot_param>
        <robot_param_node>${robot_param_node}</robot_param_node>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- 3D Camera Sensor Macro attached to hand -->
  <xacro:macro name="panda_camera" params="prefix">
    <link name="${prefix}wrist_camera_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="${prefix}wrist_camera_joint" type="fixed">
      <parent link="${prefix}hand"/>
      <child link="${prefix}wrist_camera_link"/>
      <origin xyz="0.04 0 0.06" rpy="0 -1.57079632679 0"/>
    </joint>
    <link name="${prefix}wrist_camera_optical_frame"/>
    <joint name="${prefix}wrist_camera_optical_joint" type="fixed">
      <parent link="${prefix}wrist_camera_link"/>
      <child link="${prefix}wrist_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <gazebo reference="${prefix}wrist_camera_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
    <gazebo reference="${prefix}wrist_camera_link">
      <sensor type="camera" name="wrist_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <topic>wrist_camera/image_raw</topic>
        <camera name="wrist_camera">
          <horizontal_fov>1.25</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Gazebo DetachableJoint used by the pick and place demo -->
  <xacro:macro name="panda_detachable_gripper" params="
   parent_link
   child_model:=target_block
   child_link:=link
   attach_topic:=/panda/attach_object
   detach_topic:=/panda/detach_object
   output_topic:=/panda/grasp_state
  ">
    <gazebo>
      <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>${parent_link}</parent_link>
        <child_model>${child_model}</child_model>
        <child_link>${child_link}</child_link>
        <attach_topic>${attach_topic}</attach_topic>
        <detach_topic>${detach_topic}</detach_topic>
        <output_topic>${output_topic}</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
